{
  "manifest_version": 3,
  "name": "Coursera Automation Extension",
  "version": "2.2",
  "author": "Satish (https://satish.com.np)",
  "homepage_url": "https://satish.com.np",
  "version_name": "2.2 (Free & Pro Edition)",
  "description": "Automate Coursera course videos, Watch Video, reading materials, ungraded plugins, discussions, shareable links, and complete course backups.",
  "permissions": [
    "storage",
    "cookies",
    "activeTab",
    "scripting",
    "tabs",
    "commands",
    "downloads"
  ],
  "background": {
    "service_worker": "scripts/car.js"
  },
  "icons": {
    "16": "assets/i16.png",
    "32": "assets/i32.png",
    "48": "assets/i48.png",
    "128": "assets/i128.png"
  },
  "action": {
    "default_popup": "van.html"
  },
  "options_page": "box.html",
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "*://*.coursera.org/*"
      ],
      "js": [
        "scripts/trk.js",
        "scripts/bus.js"
      ],
      "css": [
        "ui/pad.css"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "windows": "Alt+Q",
        "mac": "Alt+Q",
        "chromeos": "Alt+Q",
        "linux": "Alt+Q"
      },
      "description": "Open Study Companion Extension"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/cab.js"
      ],
      "matches": [
        "*://*.coursera.org/*"
      ]
    }
  ],
  "host_permissions": [
    "*://*.coursera.org/*",
    "https://*/*",
    "http://*/*"
  ]
}
